# 鹰眼监控系统 Docker Compose 环境变量配置文件
# 复制此文件为 .env 并根据实际环境修改配置

# ============================
# 基础配置
# ============================

# Spring Boot 环境
SPRING_PROFILES_ACTIVE=prod

# 时区设置
TZ=Asia/Shanghai

# 调试模式
DEBUG=false

# ============================
# 应用服务配置
# ============================

# 应用端口
APP_PORT=8080
MANAGEMENT_PORT=9090

# JVM 配置
HEAP_SIZE=1024m
METASPACE_SIZE=256m
JAVA_OPTS=-XX:+UseG1GC -XX:+UseContainerSupport

# 资源限制
MEMORY_LIMIT=2G
CPU_LIMIT=2.0
MEMORY_RESERVATION=1G
CPU_RESERVATION=1.0

# JMX 监控
ENABLE_JMX=false
JMX_PORT=9999

# ============================
# 数据库配置
# ============================

# MySQL 连接配置
DB_NAME=eaglee_prod
DB_USERNAME=eaglee_prod
DB_PASSWORD=eaglee_prod_secure_password
MYSQL_ROOT_PASSWORD=root_secure_password
MYSQL_PORT=3306

# 数据库连接池配置
DB_POOL_MIN_IDLE=10
DB_POOL_MAX_SIZE=50
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000

# MySQL 资源限制
MYSQL_MEMORY_LIMIT=1G
MYSQL_CPU_LIMIT=1.0
MYSQL_MEMORY_RESERVATION=512M
MYSQL_CPU_RESERVATION=0.5

# ============================
# Redis 配置
# ============================

# Redis 连接配置
CACHE_TYPE=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_MAX_MEMORY=256mb

# Redis 资源限制
REDIS_MEMORY_LIMIT=512M
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_RESERVATION=256M
REDIS_CPU_RESERVATION=0.25

# ============================
# 日志配置
# ============================

# 日志级别
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_EAGLEE=INFO

# ============================
# 监控配置
# ============================

# Actuator 端点
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
PROMETHEUS_ENABLED=true

# Prometheus 配置
PROMETHEUS_PORT=9091

# Grafana 配置
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ============================
# 业务配置
# ============================

# 数据采集配置
COLLECTION_DEFAULT_INTERVAL=30
COLLECTION_RETRY_TIMES=3

# 度量计算配置
METRIC_CALCULATION_INTERVAL=5
METRIC_RETENTION_DAYS=90

# ============================
# 数据存储路径配置
# ============================

# 主机数据目录（绝对路径）
HOST_LOGS_PATH=./data/logs
HOST_DATA_PATH=./data/app
HOST_MYSQL_DATA_PATH=./data/mysql
HOST_MYSQL_LOGS_PATH=./data/mysql-logs
HOST_REDIS_DATA_PATH=./data/redis
HOST_PROMETHEUS_DATA_PATH=./data/prometheus
HOST_GRAFANA_DATA_PATH=./data/grafana

# ============================
# 开发环境配置（仅开发时使用）
# ============================

# 开发环境数据库配置
# DB_NAME=eaglee_dev
# DB_USERNAME=eaglee_dev
# DB_PASSWORD=eaglee_dev
# SPRING_PROFILES_ACTIVE=dev
# LOG_LEVEL_ROOT=INFO
# LOG_LEVEL_EAGLEE=DEBUG

# ============================
# 测试环境配置（仅测试时使用）
# ============================

# 测试环境配置
# SPRING_PROFILES_ACTIVE=test
# DB_NAME=eaglee_test
# DB_USERNAME=eaglee_test
# DB_PASSWORD=eaglee_test
# CACHE_TYPE=none